# Device / HTTP API
REMINDORA_HOST=0.0.0.0
REMINDORA_PORT=3090
REMINDORA_TOKEN=change-me
REMINDORA_DATA_DIR=./data
REMINDORA_TIMEZONE=Asia/Shanghai

# Chat model:
# - As a dsh plugin: uses Harness default model (Settings). No key needed here.
# - Standalone `npm start` only: OpenAI-compatible endpoint + key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Optional overrides when running inside Harness:
# REMINDORA_LLM_PROVIDER=tencent-api
# REMINDORA_LLM_MODEL=deepseek-v4-pro-ioa

# Tencent Cloud ASR / TTS
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_TTS_VOICE_TYPE=101001
